{% macro generateNav(list, nested) %}
    {% for key, item in list %}
        {% if item.url %}
            {% if item.navItem %}
                {% if nested %}
                    <a
                        class="menu-item{% if item.active %} active{% endif %}"
                        {% if item.active %}aria-current="page"{% endif %}
                        href="{{ item.url }}"
                    >{{ item.title }}</a>
                {% else %}
                    <li class="nav-item">
                        <a
                            {% if item.active %} class="nav-link active" aria-current="page" {% else %} class="nav-link" {% endif %}
                            href="{{ item.url }}"
                        >{{ item.title }}</a>
                    </li>
                {% endif %}
            {% endif %}
        {% else %}
            {% if nested %}
                <div class="submenu">
                    <button class="menu-item" type="button">{{ key }}</button>
                    <div class="menu">
                        {{ _self.generateNav(item, true) }}
                    </div>
                </div>
            {% else %}
                <li class="nav-item">
                    <button class="nav-link" type="button" data-bs-toggle="menu" aria-expanded="false">
                        {{ key }}
                    </button>
                    <div class="menu">
                        {{ _self.generateNav(item, true) }}
                    </div>
                </li>
            {% endif %}
        {% endif %}
    {% endfor %}
{% endmacro %}
